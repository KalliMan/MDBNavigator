{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "TrustedNetworks": []
  },
  "Auth": {
    "Mode": "Accounts",
    "SignUp": "Open"
  },
  "Email": {
    "Delivery": "None",
    "Smtp": {
      "Host": "smtp-relay.brevo.com",
      "Port": 587
    }
  },
  "ConnectionStrings": {
    "AppDb": "Data Source=data/mdbnavigator.db"
  },
  "RateLimiting": {
    "AuthRequestsPerMinute": 10,
    "ConnectsPerMinute": 10,
    "QueriesPerMinute": 60,
    "MaxRunningQueriesPerUser": 3,
    "FailedConnectsBeforeWait": 5,
    "FailedConnectWaitMinutes": 10
  },
  "Captcha": {
    "Provider": "None"
  },
  "Demo": {
    "Enabled": false,
    "SessionMinutes": 10,
    "SessionsPerVisitorPerDay": 3,
    "MaxActiveGuests": 10,
    "SessionsPerIpPerHour": 3,
    "LinkEmailsPerAddressPerHour": 3,
    "LinkRequestsPerIpPerHour": 10,
    "LinkValidMinutes": 30,
    "ViolationsBeforeBlock": 20,
    "BlockHours": 24
  },
  "ConnectionCache": {
    "SlidingExpirationMinutes": 480
  },
  "QueryExecution": {
    "BatchSize": 500,
    "CommandTimeoutSeconds": 0,
    "MaxConcurrentQueries": 8,
    "MaxRowsPerResultSet": 100000,
    "MaxRunSeconds": 0,
    "MaxRowsPerRun": 0,
    "MaxRowBytes": 0
  }
}
