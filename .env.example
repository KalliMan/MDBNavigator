# Copy to .env to change the defaults of docker-compose.yml. .env is git-ignored.

# The admin account created at the first start.
MDBNAV_ADMIN_EMAIL=admin@example.com
MDBNAV_ADMIN_PASSWORD=change-this-password

# The port on this machine.
MDBNAV_PORT=8080

# Optional: 32 random bytes in base64 (openssl rand -base64 32). Lets saved connections remember passwords.
MDBNAV_PASSWORD_KEY=

# The sample database's read-only user, demo_reader, created at the first start.
MDBNAV_DEMO_READER_PASSWORD=demo-reader

# Only for the public demo (compose.demo.yaml). All of them are required there.
# The secrets in invite links (https://<your address>/?code=...), one per place the link is shared (LinkedIn, CV,
# Friends). At least one; 16+ random characters each (openssl rand -hex 16); blank switches a link off.
# Changing one stops only the links that carry it.
#MDBNAV_DEMO_CODE_LINKEDIN=
#MDBNAV_DEMO_CODE_CV=
#MDBNAV_DEMO_CODE_FRIENDS=
# Gets an email for every new visitor.
#MDBNAV_DEMO_OWNER_EMAIL=
# Shown in the demo terms, for visitors who want their data deleted.
#MDBNAV_DEMO_CONTACT_EMAIL=
# The demo's address, without https:// (e.g. demo.example.com). Caddy gets its certificate, and the emailed links
# point to https://<it>.
#MDBNAV_DOMAIN=
# Other names that redirect to the demo, separated by spaces (e.g. example.com www.example.com). Default:
# www.<MDBNAV_DOMAIN>. Caddy gets a certificate for each, so every name here and MDBNAV_DOMAIN must point at the
# server in DNS before the first start.
#MDBNAV_REDIRECT_DOMAINS=
# The sender of the emails, and the SMTP account that sends them (default host: Brevo, port 587).
#MDBNAV_EMAIL_FROM=
#MDBNAV_SMTP_HOST=smtp-relay.brevo.com
#MDBNAV_SMTP_PORT=587
#MDBNAV_SMTP_USERNAME=
#MDBNAV_SMTP_PASSWORD=
# Ports Caddy listens on. Change them only for a test run next to another instance.
#MDBNAV_HTTP_PORT=80
#MDBNAV_HTTPS_PORT=443
# The network between Caddy and the app; the app believes forwarded headers only from it. Change it only if
# Docker says the range is taken.
#MDBNAV_PROXY_SUBNET=172.30.254.0/24
# On the demo's server: plain `docker compose ...` commands then use the demo setup (":" between files on Linux).
#COMPOSE_FILE=docker-compose.yml:compose.demo.yaml
