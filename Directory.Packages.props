<Project>
  <!--
    Central package management: every NuGet version lives here.
    In a .csproj write only <PackageReference Include="Name" /> (no Version).
    Before adding a package, check its licence: permissive only (MIT, Apache-2.0, BSD, PostgreSQL), no commercial tiers.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Application">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />                                    <!-- Apache-2.0 -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />       <!-- Apache-2.0 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" /> <!-- MIT -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />          <!-- MIT -->
  </ItemGroup>
  <ItemGroup Label="Accounts">
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />                        <!-- Apache-2.0 -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />                            <!-- Apache-2.0 -->
    <PackageVersion Include="MailKit" Version="4.18.2" />                                             <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.14" />         <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.14" /> <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" /> <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />  <!-- MIT -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />               <!-- MIT -->
  </ItemGroup>
  <ItemGroup Label="PostgreSQL provider">
    <PackageVersion Include="Dapper" Version="2.1.35" />                                              <!-- Apache-2.0 -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />                                              <!-- PostgreSQL -->
  </ItemGroup>
  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />               <!-- MIT -->
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />                                   <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />                   <!-- MIT -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />                <!-- MIT -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />                             <!-- MIT -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />                           <!-- MIT -->
    <PackageVersion Include="xunit" Version="2.9.3" />                                                <!-- Apache-2.0 -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />                            <!-- Apache-2.0 -->
  </ItemGroup>
</Project>
