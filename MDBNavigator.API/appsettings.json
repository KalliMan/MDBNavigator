{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionCache": {
    "SlidingExpirationMinutes": 480
  },
  "QueryExecution": {
    "BatchSize": 500,
    "CommandTimeoutSeconds": 0,
    "MaxConcurrentQueries": 8,
    "MaxRowsPerExecution": 100000
  }
}
