# The production build is served by the API itself (MDBNavigator.API/wwwroot), so it talks to its own origin:
# relative URLs keep the page's scheme (HTTPS) and host, wherever it is deployed.
VITE_API_URL=/api
VITE_SIGNALR_URL=

# UI hosted separately from the API: override at build time, e.g.
#VITE_API_URL=https://mdbnavigator-api.wonderfulglacier-2c666d8f.westus2.azurecontainerapps.io/api
#VITE_SIGNALR_URL=https://mdbnavigator-api.wonderfulglacier-2c666d8f.westus2.azurecontainerapps.io
